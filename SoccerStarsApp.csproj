<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Assets\**" />
    <Compile Remove="SoccerStarsApp_Release\**" />
    <EmbeddedResource Remove="Assets\**" />
    <EmbeddedResource Remove="SoccerStarsApp_Release\**" />
    <None Remove="Assets\**" />
    <None Remove="SoccerStarsApp_Release\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Players.csv" />
    <None Remove="SoccerStarsApp_Executable\Sounds\Journey - Separate Ways %28Worlds Apart%29.mp3" />
    <None Remove="SoccerStarsApp_Executable\Sounds\Kelly Osbourne - One Word %28Official Instrumental%29.mp3" />
    <None Remove="SoccerStarsApp_Executable\Sounds\Michael Jackson - Beat It %28Official Instrumental%29.mp3" />
    <None Remove="SoccerStarsApp_Executable\Sounds\OneRepublic  -  Love Runs Out %28Official Instrumental%29.mp3" />
    <None Remove="SoccerStarsApp_Executable\Sounds\Paul McCartney ft. Michael Jackson - Say say say %28Official Instrumental%29.mp3" />
    <None Remove="SoccerStarsApp_Executable\Sounds\Pet Shop Boys - Opportunities %28Let%27s Make Lots Of Money%29 %28Official Instrumental%29.mp3" />
    <None Remove="SoccerStarsApp_Executable\Sounds\The Weeknd - Blinding Lights %28Official Instrumental%29.mp3" />
    <None Remove="SoccerStarsApp_Executable\Sounds\Windows Sound Effect - Error.mp3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Players.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SoccerStarsApp_Executable\Sounds\Journey - Separate Ways (Worlds Apart).mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SoccerStarsApp_Executable\Sounds\Kelly Osbourne - One Word (Official Instrumental).mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SoccerStarsApp_Executable\Sounds\Michael Jackson - Beat It (Official Instrumental).mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SoccerStarsApp_Executable\Sounds\OneRepublic  -  Love Runs Out (Official Instrumental).mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SoccerStarsApp_Executable\Sounds\Paul McCartney ft. Michael Jackson - Say say say (Official Instrumental).mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SoccerStarsApp_Executable\Sounds\Pet Shop Boys - Opportunities (Let's Make Lots Of Money) (Official Instrumental).mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SoccerStarsApp_Executable\Sounds\The Weeknd - Blinding Lights (Official Instrumental).mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SoccerStarsApp_Executable\Sounds\Windows Sound Effect - Error.mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
